  "bin": {
    "int": "cli.mjs",
    "introsio": "cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "cli.mjs",
    "lib",
    "hook",
    "agents",
    "opencode",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/run.js",
    "prepublishOnly": "node test/run.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/introsio/Introsio-cli.git"
  },
  "homepage": "https://github.com/introsio/Introsio-cli#readme",
  "bugs": {
    "url": "https://github.com/introsio/Introsio-cli/issues"
  },
  "keywords": [
    "claude-code",
    "cli",
    "codex",
    "coding-agent",
    "cursor",
    "gemini-cli",
    "hooks",
    "introsio",
    "mcp",
    "model-context-protocol",
    "opencode"
  ],
  "publishConfig": {
